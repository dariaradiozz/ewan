# ── Single account ────────────────────────────────────────────────────────────
# Use this if you only have one Discord account
DISCORD_TOKEN=paste_your_token_here

# Optional: comma-separated channel IDs to limit which channels the bot watches
# Leave blank (or remove the line) to watch ALL channels
# CHANNEL_IDS=123456789,987654321

# ── Multiple accounts ─────────────────────────────────────────────────────────
# You can use any suffix — BARUSU, VENTI, ALT, 1, 2, etc.
# Comment out DISCORD_TOKEN above and uncomment these instead:

# DISCORD_TOKEN_BARUSU=paste_barusu_token_here
# CHANNEL_IDS_BARUSU=123456789,987654321

# DISCORD_TOKEN_VENTI=paste_venti_token_here
# CHANNEL_IDS_VENTI=
